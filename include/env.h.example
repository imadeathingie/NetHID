#pragma once
// ============================================================
//  env.h — local secrets (WiFi credentials, web password)
//
//  Committed with SAMPLE values only. Put your REAL values here locally;
//  git is told to ignore your changes (see README "Keeping secrets out of git").
// ============================================================

// ── WiFi networks ───────────────────────────────────────────
// List every network on ONE line each, in the form:
//     WIFI(ssid, password, auth_mode)
//   auth_mode: 0 = WPA2-AES   1 = WPA/WPA2   2 = WPA3/WPA2   3 = WPA3   4 = open
//
// Add or remove lines freely — there is no count to maintain and no numbered
// macros. On boot the device connects to the in-range network with the
// strongest signal among those listed. (For an open network use "" and 4.)
#define WIFI_NETWORK_LIST \
    WIFI("MyNetwork",     "wifi-password-here", 2) \
    /* WIFI("CafeWiFi",   "",                   4) */

// ── Web UI / control password ───────────────────────────────
// Legacy single password. Still works as the "admin" login if you don't define
// a USER_LIST below. "" disables auth (not advised).
#define PASSWORD         "changeme"

// ── Users (challenge-response login) ─────────────────────────
// One USER(name, password) per line. The password never crosses the network —
// the device proves knowledge via HMAC-SHA256 over a one-time nonce. Remove
// this block to fall back to the single PASSWORD above (as user "admin").
#define USER_LIST \
    USER("admin", "changeme") \
    USER("guest", "guestpass") 

// ── Secrets (typed by reference, never sent) ─────────────────
// One entry per line. Reference any of them inside TEXT shortcuts as ${NAME}.
//   SECRET(name, value)            — GLOBAL: usable by every logged-in user.
//   SECRET_FOR(user, name, value)  — PRIVATE: only that user may expand ${name};
//                                    others get nothing. A private secret of a
//                                    given name overrides a global of the same
//                                    name for its owner.
// So below, both alice and bob can type ${WIN_PASS} and each gets THEIR OWN
// password; ${EMAIL} is shared. Bob can never read alice's WIN_PASS.
#define SECRET_LIST \
    SECRET("EMAIL", "team@example.com") \
    SECRET_FOR("admin", "WIN_PASS", "win-pass")

// Require HMAC challenge-response (reject plaintext-password auth). Leave at the
// config.h default (1, plaintext allowed) until your clients speak HMAC, then
// set to 0 here to harden.
// #define ALLOW_PLAINTEXT_AUTH 0

// ── Per-user web tabs ────────────────────────────────────────
// admin (ADMIN_USER) sees every tab automatically. Grant tabs to other users
// here; "*" means everyone. Built-in ids: keyboard, mouse, macros, media,
// customedit. The "irdb" IR finder tab also exists when ENABLE_REMOTES is on. Remove this block to leave the UI ungated (everyone sees all).
// Below: everyone gets keyboard + media; alice also mouse + macros; bob also
// macros; only admin gets the custom-tab editor.
#define TAB_GRANTS \
    TAB_FOR("*",     "keyboard") \
    TAB_FOR("*",     "media") \
    TAB_FOR("*",     "mouse") \
    TAB_FOR("*",     "macros") \
    TAB_FOR("admin", "keymap") \
    TAB_FOR("admin", "wifi") \
    TAB_FOR("admin", "settings")

// ── AP setup mode ────────────────────────────────────────────────────────────
// Password for the network NetHID serves when you hold the AP key at boot.
// At least 8 characters — the firmware refuses to start an open access point,
// because anyone who joins it is one login page away from your host's keyboard.
#define AP_PASSWORD "change-this-please"

// Optional: rename the setup network.
// #define AP_SSID "NetHID-Setup"
